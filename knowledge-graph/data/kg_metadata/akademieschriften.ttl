<https://akademieschriften.bbaw.de/kg/ontology> a owl:Ontology ;
    rdfs:label "Ontologie der Digitalisierten Akademieschriften"@de ;
    rdfs:comment "Abhandlungen der Berliner Akademie der Wissenschaften 1710–1900, gewonnen aus den Katalogmetadaten und der Analyse der Titel."@de .

das:Ort a owl:Class ;
    rdfs:label "Ort"@de ;
    rdfs:subClassOf schema:Place .

das:Werk a owl:Class ;
    rdfs:label "Werk"@de ;
    rdfs:comment "Im Titel erwähntes Werk, Text oder Handschrift."@de ;
    rdfs:subClassOf schema:CreativeWork .

das:abgleichScore a owl:DatatypeProperty ;
    rdfs:label "Score des Normdatenabgleichs"@de .

das:abgleichStatus a owl:DatatypeProperty ;
    rdfs:label "Status des Normdatenabgleichs"@de .

das:anlass a owl:ObjectProperty ;
    rdfs:label "Anlass"@de ;
    rdfs:range das:Anlass .

das:anzahlTabellen a owl:DatatypeProperty ;
    rdfs:label "Anzahl Tabellen"@de .

das:anzahlTafeln a owl:DatatypeProperty ;
    rdfs:label "Anzahl Tafeln"@de .

das:autor a owl:ObjectProperty ;
    rdfs:label "Autor"@de ;
    rdfs:domain das:Abhandlung ;
    rdfs:range das:Person ;
    rdfs:subPropertyOf dcterms:creator .

das:bandnummer a owl:DatatypeProperty ;
    rdfs:label "Bandbezeichnung"@de .

das:behandelterZeitraum a owl:DatatypeProperty ;
    rdfs:label "behandelter Zeitraum"@de .

das:briefschreiber a owl:ObjectProperty ;
    rdfs:label "Briefschreiber"@de ;
    rdfs:subPropertyOf das:beteiligt .

das:digitalisat a owl:ObjectProperty ;
    rdfs:label "Digitalisat"@de ;
    rdfs:subPropertyOf foaf:page .

das:disziplin a owl:ObjectProperty ;
    rdfs:label "Disziplin"@de ;
    rdfs:range das:Disziplin ;
    rdfs:subPropertyOf dcterms:subject .

das:erschienenIm a owl:ObjectProperty ;
    rdfs:label "erschienen im Jahr"@de ;
    rdfs:range das:Jahr .

das:erwaehnt a owl:ObjectProperty ;
    rdfs:label "erwähnt"@de ;
    rdfs:subPropertyOf schema:mentions .

das:erwaehntesDatum a owl:DatatypeProperty ;
    rdfs:label "im Titel genanntes Datum"@de .

das:erwaehntesJahr a owl:DatatypeProperty ;
    rdfs:label "im Titel genanntes Jahr"@de .

das:gattung a owl:ObjectProperty ;
    rdfs:label "Gattung"@de ;
    rdfs:range das:Gattung ;
    rdfs:subPropertyOf dcterms:type .

das:handeltVon a owl:ObjectProperty ;
    rdfs:label "handelt von"@de ;
    rdfs:comment "Person, Ort oder Werk als Gegenstand der Abhandlung."@de ;
    rdfs:subPropertyOf schema:about .

das:hatAntwort a owl:ObjectProperty ;
    rdfs:label "hat Antwort"@de ;
    rdfs:subPropertyOf das:textbeziehung ;
    owl:inverseOf das:hatAntrittsrede .

das:hatAuszug a owl:ObjectProperty ;
    rdfs:label "hat Auszug"@de ;
    rdfs:subPropertyOf das:textbeziehung ;
    owl:inverseOf das:hatVolltext .

das:hatFiguren a owl:DatatypeProperty ;
    rdfs:label "enthält Figuren"@de .

das:hatFortsetzung a owl:ObjectProperty ;
    rdfs:label "hat Fortsetzung"@de ;
    rdfs:subPropertyOf das:textbeziehung .

das:hatHauptteil a owl:ObjectProperty ;
    rdfs:label "hat Hauptteil"@de ;
    rdfs:comment "Gegenrichtung zu das:hatFortsetzung und das:hatNachtrag."@de ;
    rdfs:subPropertyOf das:textbeziehung .

das:hatNachtrag a owl:ObjectProperty ;
    rdfs:label "hat Nachtrag"@de ;
    rdfs:subPropertyOf das:textbeziehung .

das:hatUebersetzung a owl:ObjectProperty ;
    rdfs:label "hat Übersetzung"@de ;
    rdfs:subPropertyOf frbr:translation,
        das:textbeziehung ;
    owl:inverseOf das:hatOriginal .

das:haupttitel a owl:DatatypeProperty ;
    rdfs:label "Haupttitel (ohne Teilbezeichnung)"@de .

das:inBand a owl:ObjectProperty ;
    rdfs:label "erschienen in Band"@de ;
    rdfs:domain das:Abhandlung ;
    rdfs:range das:Band ;
    rdfs:subPropertyOf frbr:partOf .

das:inReihe a owl:ObjectProperty ;
    rdfs:label "gehört zur Reihe"@de ;
    rdfs:domain das:Band ;
    rdfs:range das:Schriftenreihe ;
    rdfs:subPropertyOf frbr:partOf .

das:jahrQuelle a owl:DatatypeProperty ;
    rdfs:label "Herkunft der Jahresangabe"@de .

das:klammerzusatz a owl:DatatypeProperty ;
    rdfs:label "Zusatz in eckigen Klammern"@de .

das:kommentator a owl:ObjectProperty ;
    rdfs:label "Kommentator"@de ;
    rdfs:subPropertyOf das:beteiligt .

das:kuerzel a owl:DatatypeProperty ;
    rdfs:label "Kürzel"@de .

das:mitautor a owl:ObjectProperty ;
    rdfs:label "Mitautor"@de ;
    rdfs:subPropertyOf das:beteiligt .

das:mitwirkung a owl:ObjectProperty ;
    rdfs:label "Mitwirkung"@de ;
    rdfs:subPropertyOf das:beteiligt .

das:objekt a owl:DatatypeProperty ;
    rdfs:label "erwähntes Objekt"@de .

das:ppn a owl:DatatypeProperty ;
    rdfs:label "K10plus-PPN"@de .

das:taxon a owl:DatatypeProperty ;
    rdfs:label "erwähntes Taxon"@de .

das:teil a owl:DatatypeProperty ;
    rdfs:label "Teilbezeichnung"@de .

das:teilNummer a owl:DatatypeProperty ;
    rdfs:label "Nummer des Teils"@de .

das:teilTyp a owl:DatatypeProperty ;
    rdfs:label "Art des Teils"@de .

das:thema a owl:ObjectProperty ;
    rdfs:label "Thema"@de ;
    rdfs:range das:Thema ;
    rdfs:subPropertyOf dcterms:subject .

das:titelDeutsch a owl:DatatypeProperty ;
    rdfs:label "deutsche Wiedergabe des Titels"@de ;
    rdfs:subPropertyOf dcterms:alternative .

das:verweistAuf a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "verweist auf"@de ;
    rdfs:subPropertyOf rdfs:seeAlso,
        das:textbeziehung .

das:vorwort a owl:ObjectProperty ;
    rdfs:label "Verfasser des Vorworts"@de ;
    rdfs:subPropertyOf das:beteiligt .

