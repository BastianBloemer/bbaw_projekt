{
  "database": "Zotero",
  "noteImportFolder": "material",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [],
  "exportFormats": [
    {
      "name": "zotero-abstracts",
      "outputPathTemplate": "material/abstracts/{{title}}.md",
      "imageOutputPathTemplate": "material/used_images/{{title}}/",
      "imageBaseNameTemplate": "image",
      "templatePath": "material/templates/zotero-abstracts.md"
    },
    {
      "name": "zotero-annotationen",
      "outputPathTemplate": "material/notes/{{title}}.md",
      "imageOutputPathTemplate": "material/used_images/{{title}}/",
      "imageBaseNameTemplate": "image",
      "templatePath": "material/templates/zotero-annotationen.md"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": false,
  "whichNotesToOpenAfterImport": "first-imported-note",
  "shouldConcat": true
}